{
  "metadata": {
    "name": "Population plotter",
    "version": "1.0.0",
    "description": "Choose a CSV of names and numbers and see it as a chart. One page, one code node: the code says what to plot, the chart block draws it. Choosing a file redraws it -- there is nothing to press. Paths are relative to the working directory, so run this from the repository root.",
    "author": "",
    "tags": [
      "example",
      "plot",
      "csv",
      "gui"
    ],
    "ai_defaults": {
      "provider": "default",
      "model": ""
    },
    "gui_scheme": "night"
  },
  "nodes": [
    {
      "id": "page",
      "node_type": "gui",
      "label": "Plotter",
      "description": "The page this tool shows",
      "inputs": [
        {
          "id": "plot_in",
          "name": "plot",
          "kind": "input",
          "data_type": "any",
          "multi": true,
          "required": false,
          "description": ""
        }
      ],
      "outputs": [
        {
          "id": "file_out",
          "name": "CSV file",
          "kind": "output",
          "data_type": "file_path",
          "multi": false,
          "required": false,
          "description": ""
        }
      ],
      "config": {
        "gui_widgets": [
          {
            "h": 1,
            "id": "title",
            "kind": "text",
            "label": "",
            "mode": "heading",
            "tone": "plain",
            "value": "Population plotter",
            "w": 16
          },
          {
            "extensions": ".csv",
            "h": 2,
            "id": "file",
            "kind": "input_picker",
            "label": "CSV file",
            "mode": "file",
            "run_on_change": true,
            "tone": "sunken",
            "value": "examples/data/population.csv",
            "w": 16
          },
          {
            "h": 9,
            "id": "plot",
            "kind": "plot_window",
            "label": "",
            "tone": "plain",
            "w": 16
          }
        ]
      }
    },
    {
      "id": "chart",
      "node_type": "code",
      "label": "What to plot",
      "description": "Reads the CSV and says what the chart should show",
      "inputs": [
        {
          "id": "csv",
          "name": "CSV",
          "kind": "input",
          "data_type": "file_path",
          "multi": false,
          "required": false,
          "description": ""
        }
      ],
      "outputs": [
        {
          "id": "figure",
          "name": "Figure",
          "kind": "output",
          "data_type": "json",
          "multi": false,
          "required": false,
          "description": ""
        }
      ],
      "config": {
        "batch_mode": "whole_list",
        "read_file_inputs": true
      }
    }
  ],
  "edges": [
    {
      "id": "file-to-chart",
      "source_node_id": "page",
      "source_port_id": "file_out",
      "target_node_id": "chart",
      "target_port_id": "csv"
    },
    {
      "id": "chart-to-plot",
      "source_node_id": "chart",
      "source_port_id": "figure",
      "target_node_id": "page",
      "target_port_id": "plot_in"
    }
  ]
}
