            "selector_code": "",
            "code": "def run(inputs: dict) -> dict:\n    \"\"\"Turn the CSV rows (list of dicts with 'Land'/'Bevölkerung') into\n    chart points the app renders as an SVG bar chart.\"\"\"\n    rows = inputs.get(\"value\") or []\n    if isinstance(rows, dict):  # already {label: value}\n        rows = [{\"label\": k, \"value\": v} for k, v in rows.items()]\n    points = []\n    for row in rows:\n        if not isinstance(row, dict):\n            continue\n        label = row.get(\"label\") or row.get(\"Land\") or next(iter(row.values()), \"\")\n        raw = row.get(\"value\") or row.get(\"Bevölkerung\")\n        try:\n            points.append({\"label\": str(label), \"value\": float(raw)})\n        except (TypeError, ValueError):\n            continue\n    return {\"value\": points}\n",
            "language": "python",
            "plot_prompt": "create a plot over the number of people in countries (\"Säulendiagramm\"). Create a proper caption and axis.",
