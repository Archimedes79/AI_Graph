{
  "metadata": {
    "name": "Bla Counter",
    "version": "1.0.0",
    "description": "Counts how often the word \"bla\" appears across every Markdown file in a directory, then summarises the result.",
    "author": "",
    "tags": ["example", "batch"],
    "ai_defaults": { "provider": "default", "model": "" }
  },
  "nodes": [
    {
      "id": "folder",
      "node_type": "input",
      "label": "Text Folder",
      "description": "Lists the .md files in a directory; the paths are read into content by the next node.",
      "position": { "x": 60, "y": 140 },
      "inputs": [],
      "outputs": [
        { "id": "files", "name": "Files", "kind": "output", "data_type": "file_path", "multi": true, "required": false, "description": "" },
        { "id": "count", "name": "Count", "kind": "output", "data_type": "text", "multi": false, "required": false, "description": "" }
      ],
      "config": { "value": "", "input_mode": "directory", "prompt_at_runtime": true, "select_all_files": true, "extensions": ".md" }
    },
    {
      "id": "count_per_file",
      "node_type": "code",
      "label": "Count per File",
      "description": "Runs once per file (per_item batching) and counts the occurrences of \"bla\".",
      "position": { "x": 380, "y": 140 },
      "inputs": [
        { "id": "file", "name": "File", "kind": "input", "data_type": "file_path", "multi": true, "required": false, "description": "" }
      ],
      "outputs": [
        { "id": "output", "name": "Output", "kind": "output", "data_type": "json", "multi": true, "required": false, "description": "" }
      ],
      "config": {
        "language": "python",
        "read_file_inputs": true,
        "batch_mode": "per_item",
        "code_prompt": "Count how often the word 'bla' appears in the file's text.",
        "code": "def run(inputs):\n    text = str(inputs.get('file') or '')\n    return {'output': {'count': text.lower().split().count('bla')}}\n"
      }
    },
    {
      "id": "total",
      "node_type": "code",
      "label": "Total & Summary",
      "description": "Receives the whole list at once (whole_list batching) and reduces it.",
      "position": { "x": 700, "y": 140 },
      "inputs": [
        { "id": "counts", "name": "Counts", "kind": "input", "data_type": "json", "multi": true, "required": false, "description": "" }
      ],
      "outputs": [
        { "id": "bla_count", "name": "Bla Count", "kind": "output", "data_type": "text", "multi": false, "required": false, "description": "" },
        { "id": "summary", "name": "Summary", "kind": "output", "data_type": "text", "multi": false, "required": false, "description": "" }
      ],
      "config": {
        "language": "python",
        "batch_mode": "whole_list",
        "code_prompt": "Sum the per-file counts and write a one-line summary.",
        "code": "def run(inputs):\n    items = inputs.get('counts') or []\n    if not isinstance(items, list):\n        items = [items]\n    counts = [int((item or {}).get('count', 0)) for item in items]\n    total = sum(counts)\n    return {\n        'bla_count': total,\n        'summary': f\"Found 'bla' {total} time(s) across {len(counts)} file(s).\",\n    }\n"
      }
    },
    {
      "id": "result",
      "node_type": "output",
      "label": "Result",
      "description": "",
      "position": { "x": 1020, "y": 140 },
      "inputs": [
        { "id": "bla_count", "name": "Bla Count", "kind": "input", "data_type": "any", "multi": false, "required": false, "description": "" },
        { "id": "summary", "name": "Summary", "kind": "input", "data_type": "any", "multi": false, "required": false, "description": "" }
      ],
      "outputs": [],
      "config": { "output_label": "Bla Counter Result", "write_mode": "window" }
    }
  ],
  "edges": [
    { "id": "e1", "source_node_id": "folder", "source_port_id": "files", "target_node_id": "count_per_file", "target_port_id": "file" },
    { "id": "e2", "source_node_id": "count_per_file", "source_port_id": "output", "target_node_id": "total", "target_port_id": "counts" },
    { "id": "e3", "source_node_id": "total", "source_port_id": "bla_count", "target_node_id": "result", "target_port_id": "bla_count" },
    { "id": "e4", "source_node_id": "total", "source_port_id": "summary", "target_node_id": "result", "target_port_id": "summary" }
  ]
}
