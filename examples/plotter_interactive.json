    {
      "id": "points",
      "node_type": "code",
      "label": "Zu Punkten",
      "description": "`read_file_inputs` turns the picked path into the file's text before this runs, so the node never touches the filesystem itself.",
      "position": {
        "x": 252.10112359550556,
        "y": 515.5617977528091
      },
      "width": 240,
      "height": 184,
      "inputs": [
        {
          "id": "csv",
          "name": "CSV",
          "kind": "input",
          "data_type": "file_path",
          "multi": false,
          "required": false,
          "description": "Resolved to the file's content before the node runs",
          "format": null,
          "debug_directory": null
        }
      ],
      "outputs": [
        {
          "id": "points",
          "name": "Points",
          "kind": "output",
          "data_type": "json",
          "multi": false,
          "required": false,
          "description": "[{label, value}] ready to plot",
          "format": null,
          "debug_directory": null
        }
      ],
      "config": {
        "value": null,
        "prompt_at_runtime": false,
        "input_mode": "text",
        "recursive": false,
        "extensions": "",
        "select_all_files": true,
        "selector_prompt": "",
        "selector_code": "",
        "ai_provider": "default",
        "ai_model": "",
        "system_prompt": "",
        "temperature": 0.7,
        "language": "python",
        "code": "import csv\nimport io\n\n\ndef run(inputs):\n    \"\"\"CSV text -> plot-ready points.\n\n    The chart is drawn by the app, so this only reshapes data: a list of\n    {\"label\": str, \"value\": number}. Column names are read from the header\n    rather than hard-coded, so the same node plots any two-column CSV.\n    \"\"\"\n    rows = list(csv.DictReader(io.StringIO(inputs.get(\"csv\") or \"\")))\n    if not rows:\n        return {\"points\": []}\n\n    columns = list(rows[0].keys())\n    label_column = columns[0]\n    value_column = columns[1] if len(columns) > 1 else columns[0]\n\n    points = []\n    for row in rows:\n        raw = str(row.get(value_column) or \"\").strip().replace(\" \", \"\").replace(\".\", \"\")\n        raw = raw.replace(\",\", \".\")\n        try:\n            value = float(raw)\n        except ValueError:\n            continue  # a stray footer line is not a data point\n        points.append({\"label\": str(row.get(label_column) or \"\"), \"value\": round(value / 1_000_000, 1)})\n\n    points.sort(key=lambda point: point[\"value\"], reverse=True)\n    return {\"points\": points}\n",
        "code_prompt": "Turn the CSV into a list of {label, value} points, largest first, scaled to millions.",
        "code_file": "",
