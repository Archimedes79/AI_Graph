          "kind": "input",
          "data_type": "file_path",
          "multi": false,
          "required": false,
          "description": "Resolved to the file's content before the node runs",
          "format": null,
          "debug_directory": null
        }
      ],
      "outputs": [
        {
          "id": "points",
          "name": "Points",
          "kind": "output",
          "data_type": "json",
          "multi": false,
          "required": false,
          "description": "[{label, value}] ready to plot",
          "format": null,
          "debug_directory": null
        }
      ],
      "config": {
        "value": null,
        "prompt_at_runtime": false,
        "input_mode": "text",
        "recursive": false,
        "extensions": "",
        "select_all_files": true,
        "selector_prompt": "",
        "selector_code": "",
        "ai_provider": "default",
        "ai_model": "",
        "system_prompt": "",
        "temperature": 0.7,
        "code": "/**\n * CSV text -> plot-ready points.\n *\n * The chart is drawn by the app, so this only reshapes data: a list of\n * {label, value}. Column names are read from the header rather than\n * hard-coded, so the same node plots any two-column CSV.\n *\n * @typedef {Object} Inputs\n * @property {string} csv\n */\n\n/** @param {Inputs} inputs */\nfunction run(inputs) {\n  const lines = String(inputs.csv ?? '').split(/\\r?\\n/).filter((line) => line.trim());\n  if (lines.length < 2) return { points: [] };\n\n  const split = (line) => line.split(/[;,\\t]/).map((cell) => cell.trim());\n  const header = split(lines[0]);\n  const labelColumn = 0;\n  const valueColumn = header.length > 1 ? 1 : 0;\n\n  const points = [];\n  for (const line of lines.slice(1)) {\n    const cells = split(line);\n    // German thousands separators: 1.234.567,8 -> 1234567.8\n    const raw = String(cells[valueColumn] ?? '').replace(/[ .]/g, '').replace(',', '.');\n    const value = Number(raw);\n    if (raw === '' || Number.isNaN(value)) continue; // a stray footer line is not a data point\n    points.push({ label: String(cells[labelColumn] ?? ''), value: Math.round(value / 100000) / 10 });\n  }\n\n  points.sort((a, b) => b.value - a.value);\n  return { points };\n}\n",
        "code_prompt": "Turn the CSV into a list of {label, value} points, largest first, scaled to millions.",
        "code_file": "",
        "data_value": null,
        "data_format": "text",
        "data_prompt": "",
        "data_format_prompt": "",
        "example_file": "",
        "output_format": "json",
        "output_format_prompt": "",
        "batch_mode": "whole_list",
