    {
      "id": "points",
      "node_type": "code",
      "label": "Zu Punkten",
      "description": "`read_file_inputs` turns the picked path into the file's text before this runs, so the node never touches the filesystem itself.",
      "position": {
        "x": 252.10112359550556,
        "y": 515.5617977528091
      },
      "width": 240,
      "height": 184,
      "inputs": [
        {
          "id": "csv",
