{
  "metadata": {
    "version": "1.0.0",
    "author": "AI-Graph",
    "ai_defaults": {
      "provider": "google",
      "model": "gemini-flash-lite-latest"
    },
    "gui_scheme": "night",
    "name": "Summarize a folder",
    "description": "Every text file in a folder is summarized on its own — the AI node runs once per file — and a second AI node then says what the files have in common. Paths are relative to the working directory, so run this from the repository root.",
    "tags": [
      "example",
      "gui",
      "ai",
      "batch",
      "triggers"
    ]
  },
  "nodes": [
    {
      "id": "page",
      "node_type": "gui",
      "label": "Folder summaries",
      "description": "The page this tool shows",
      "position": {
        "x": 60,
        "y": 140
      },
      "width": 340,
      "height": 260,
      "inputs": [
        {
          "id": "table_in",
          "name": "Each file",
          "kind": "input",
          "data_type": "any",
          "multi": true,
          "required": false,
          "description": ""
        },
        {
          "id": "overall_in",
          "name": "What they have in common",
          "kind": "input",
          "data_type": "any",
          "multi": false,
          "required": false,
          "description": ""
        }
      ],
      "outputs": [
        {
          "id": "folder_out",
          "name": "Folder",
          "kind": "output",
          "data_type": "file_path",
          "multi": true,
          "required": false,
          "description": ""
        },
        {
          "id": "go_out",
          "name": "Summarize all",
          "kind": "output",
          "data_type": "number",
          "multi": false,
          "required": false,
          "description": ""
        }
      ],
      "config": {
        "gui_widgets": [
          {
            "id": "title",
            "kind": "text",
            "label": "",
            "tone": "plain",
            "w": 16,
            "h": 1,
            "mode": "heading",
            "value": "Summarize a folder"
          },
          {
            "id": "intro",
            "kind": "text",
            "label": "",
            "tone": "plain",
            "w": 16,
            "h": 1,
            "mode": "caption",
            "value": "Every .txt file in the folder gets its own two-sentence summary; then one paragraph on what they share."
          },
          {
            "id": "folder",
            "kind": "input_picker",
            "label": "Folder",
            "tone": "sunken",
            "w": 12,
            "h": 2,
            "mode": "directory",
            "value": "examples/data/stories",
            "extensions": ".txt",
            "select_all_files": true
          },
          {
            "id": "go",
            "kind": "button",
            "label": "Summarize all",
            "tone": "plain",
            "w": 4,
            "h": 2
          },
          {
            "id": "rule",
            "kind": "divider",
            "label": "",
            "tone": "plain",
            "w": 16,
            "h": 1,
            "mode": "horizontal"
          },
          {
            "id": "table",
            "kind": "table",
            "label": "Each file",
            "tone": "plain",
            "w": 16,
            "h": 5
          },
          {
            "id": "overall",
            "kind": "text_io",
            "label": "What they have in common",
            "tone": "raised",
            "w": 16,
            "h": 4,
            "mode": "output"
          }
        ]
      }
    },
    {
      "id": "per_file",
      "node_type": "ai",
      "label": "Each file",
      "description": "Summarize one story in exactly two sentences.",
      "position": {
        "x": 560,
        "y": 60
      },
      "inputs": [
        {
          "id": "story",
          "name": "Story",
          "kind": "input",
          "data_type": "file_path",
          "multi": true,
          "required": false,
          "description": "One file per run; arrives as its content"
        }
      ],
      "outputs": [
        {
          "id": "output",
          "name": "Output",
          "kind": "output",
          "data_type": "text",
          "multi": false,
          "required": false,
          "description": "What the model answered"
        }
      ],
      "config": {
        "ai_provider": "google",
        "ai_model": "gemini-flash-lite-latest",
        "temperature": 0.3,
        "system_prompt": "You summarize short stories. Answer with exactly two sentences: the first says what happens, the second what it comes to. Do not repeat the title and do not judge the story. Answer in the language of the story, with the two sentences only.",
        "prompt_template": "",
        "output_format": "text",
        "batch_mode": "per_item",
        "read_file_inputs": true,
        "batch_concurrency": 3
      }
    },
    {
      "id": "rows",
      "node_type": "code",
      "label": "Table rows",
      "description": "Puts each file name beside its summary",
      "position": {
        "x": 860,
        "y": 40
      },
      "inputs": [
        {
          "id": "files",
          "name": "Files",
          "kind": "input",
          "data_type": "any",
          "multi": true,
          "required": false,
          "description": "Every path in the folder"
        },
        {
          "id": "summaries",
          "name": "Summaries",
          "kind": "input",
          "data_type": "text",
          "multi": true,
          "required": false,
          "description": "One per file, same order"
        }
      ],
      "outputs": [
        {
          "id": "rows",
          "name": "Rows",
          "kind": "output",
          "data_type": "json",
          "multi": false,
          "required": false,
          "description": "A list of {File, Summary}"
        }
      ],
      "config": {
        "code": "/**\n * One row per file: its name beside its summary.\n *\n * @typedef {Object} Inputs\n * @property {string[]} files      every path in the folder\n * @property {string[]} summaries  one summary per file, in the same order\n */\n\n/** @param {Inputs} inputs */\nfunction run(inputs) {\n  const files = [].concat(inputs.files ?? []);\n  const summaries = [].concat(inputs.summaries ?? []);\n  return {\n    rows: files.map(function (path, index) {\n      return {\n        File: String(path).split(/[\\\\/]/).pop(),\n        Summary: summaries[index] == null ? '(no summary — this file failed)' : String(summaries[index]).trim(),\n      };\n    }),\n  };\n}\n",
        "code_prompt": "Make one table row per file: the file name and its summary.",
        "batch_mode": "whole_list",
        "read_file_inputs": false
      }
    },
    {
      "id": "overall",
      "node_type": "ai",
      "label": "In common",
      "description": "Say what the stories share, from their summaries.",
      "position": {
        "x": 860,
        "y": 300
      },
      "inputs": [
        {
          "id": "summaries",
          "name": "Summaries",
          "kind": "input",
          "data_type": "text",
          "multi": true,
          "required": false,
          "description": "Every summary, as paragraphs"
        }
      ],
      "outputs": [
        {
          "id": "output",
          "name": "Output",
          "kind": "output",
          "data_type": "text",
          "multi": false,
          "required": false,
          "description": "What the model answered"
        }
      ],
      "config": {
        "ai_provider": "google",
        "ai_model": "gemini-flash-lite-latest",
        "temperature": 0.4,
        "system_prompt": "You are given the summaries of several short stories from one collection. Write one paragraph of at most four sentences on what the stories have in common: shared motifs, the kind of people in them, the attitude of the telling. Do not retell the plots. Answer in the language of the summaries.",
        "prompt_template": "",
        "output_format": "text",
        "batch_mode": "whole_list",
        "read_file_inputs": false
      }
    }
  ],
