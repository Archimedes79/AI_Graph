{
  "metadata": {
    "name": "File reader & summarizer",
    "version": "1.0.0",
    "description": "Pick a text file, read it, and have a model summarize it. Choosing a file or pressing Summarize starts the graph at the reader; changing the length re-runs only the summary. Paths are relative to the working directory, so run this from the repository root.",
    "author": "AI-Graph",
    "tags": [
      "example",
      "gui",
      "ai",
      "triggers"
    ],
    "ai_defaults": {
      "provider": "google",
      "model": "gemini-flash-lite-latest"
    },
    "gui_scheme": "night"
  },
  "nodes": [
    {
      "id": "page",
      "node_type": "gui",
      "label": "Summarizer",
      "description": "The page this tool shows",
      "inputs": [
        {
          "id": "summary_in",
          "name": "Summary",
          "kind": "input",
          "data_type": "any",
          "multi": false,
          "required": false,
          "description": ""
        },
        {
          "id": "about_in",
          "name": "About the file",
          "kind": "input",
          "data_type": "any",
          "multi": false,
          "required": false,
          "description": ""
        },
        {
          "id": "content_in",
          "name": "What was read",
          "kind": "input",
          "data_type": "any",
          "multi": false,
          "required": false,
          "description": ""
        }
      ],
      "outputs": [
        {
          "id": "file_out",
          "name": "File",
          "kind": "output",
          "data_type": "file_path",
          "multi": false,
          "required": false,
          "description": ""
        },
        {
          "id": "length_out",
          "name": "Length",
          "kind": "output",
          "data_type": "text",
          "multi": false,
          "required": false,
          "description": ""
        },
        {
          "id": "go_out",
          "name": "Summarize",
          "kind": "output",
          "data_type": "boolean",
          "multi": false,
          "required": false,
          "description": ""
        }
      ],
      "config": {
        "gui_widgets": [
          {
            "h": 1,
            "id": "title",
            "kind": "text",
            "label": "",
            "mode": "heading",
            "tone": "plain",
            "value": "File reader & summarizer",
            "w": 16
          },
          {
            "h": 1,
            "id": "intro",
            "kind": "text",
            "label": "",
            "mode": "caption",
            "tone": "plain",
            "value": "Choose a text file — it is read and summarized straight away. Change the length and it is summarized again.",
            "w": 16
          },
          {
            "extensions": ".txt,.md",
            "h": 2,
            "id": "file",
            "kind": "input_picker",
            "label": "File",
            "mode": "file",
            "run_on_change": true,
            "tone": "sunken",
            "value": "examples/data/stories/01_the_lighthouse_keeper.txt",
            "w": 9
          },
          {
            "h": 2,
            "id": "length",
            "kind": "select",
            "label": "Length",
            "options": "One sentence\nThree sentences\nFive bullet points",
            "run_on_change": true,
            "tone": "sunken",
            "value": "Three sentences",
            "w": 4
          },
          {
            "h": 2,
            "id": "go",
            "kind": "button",
            "label": "Summarize",
            "tone": "plain",
            "w": 3
          },
          {
            "h": 1,
            "id": "rule",
            "kind": "divider",
            "label": "",
            "mode": "horizontal",
            "tone": "plain",
            "w": 16
          },
          {
            "h": 5,
            "id": "summary",
            "kind": "text_io",
            "label": "Summary",
            "mode": "output",
            "tone": "raised",
            "w": 10
          },
          {
            "h": 5,
            "id": "about",
            "kind": "text_io",
            "label": "About the file",
            "mode": "output",
            "tone": "raised",
            "w": 6
          },
          {
            "h": 6,
            "id": "content",
            "kind": "text_io",
            "label": "What was read",
            "mode": "output",
            "tone": "raised",
            "w": 16
          }
        ]
      }
    },
    {
      "id": "reader",
      "node_type": "code",
      "label": "Read file",
      "description": "Reads the chosen file and says what it is",
      "inputs": [
        {
          "id": "file",
          "name": "File",
          "kind": "input",
          "data_type": "file_path",
          "multi": false,
          "required": false,
          "description": "The chosen file; arrives as its content"
        },
        {
          "id": "path",
          "name": "Path",
          "kind": "input",
          "data_type": "text",
          "multi": false,
          "required": false,
          "description": "The same file's path, for its name"
        }
      ],
      "outputs": [
        {
          "id": "text",
          "name": "Text",
          "kind": "output",
          "data_type": "text",
          "multi": false,
          "required": false,
          "description": "The file's content"
        },
        {
          "id": "info",
          "name": "Info",
          "kind": "output",
          "data_type": "text",
          "multi": false,
          "required": false,
          "description": "One line about the file"
        }
      ],
      "config": {
        "batch_mode": "whole_list",
        "read_file_inputs": true
      }
    },
    {
      "id": "summarizer",
      "node_type": "ai",
      "label": "Summarize",
      "description": "Summarize the text faithfully, at the length asked for.",
      "inputs": [
        {
          "id": "text",
          "name": "Text",
          "kind": "input",
          "data_type": "text",
          "multi": false,
          "required": false,
          "description": "What to summarize"
        },
        {
          "id": "length",
          "name": "Length",
          "kind": "input",
          "data_type": "text",
          "multi": false,
          "required": false,
          "description": "How long the summary should be"
        }
      ],
      "outputs": [
        {
          "id": "output",
          "name": "Output",
          "kind": "output",
          "data_type": "text",
          "multi": false,
          "required": false,
          "description": "What the model answered"
        }
      ],
      "config": {
        "ai_model": "gemini-flash-lite-latest",
        "ai_provider": "google",
        "batch_mode": "whole_list",
        "output_format": "text",
        "read_file_inputs": false,
        "temperature": 0.3
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source_node_id": "page",
      "source_port_id": "file_out",
      "target_node_id": "reader",
      "target_port_id": "file"
    },
    {
      "id": "e2",
      "source_node_id": "page",
      "source_port_id": "file_out",
      "target_node_id": "reader",
      "target_port_id": "path"
    },
    {
      "id": "e3",
      "source_node_id": "page",
      "source_port_id": "go_out",
      "target_node_id": "reader",
      "target_port_id": "__run"
    },
    {
      "id": "e4",
      "source_node_id": "reader",
      "source_port_id": "text",
      "target_node_id": "summarizer",
      "target_port_id": "text"
    },
    {
      "id": "e5",
      "source_node_id": "page",
      "source_port_id": "length_out",
      "target_node_id": "summarizer",
      "target_port_id": "length"
    },
    {
      "id": "e6",
      "source_node_id": "summarizer",
      "source_port_id": "output",
      "target_node_id": "page",
      "target_port_id": "summary_in"
    },
    {
      "id": "e7",
      "source_node_id": "reader",
      "source_port_id": "info",
      "target_node_id": "page",
      "target_port_id": "about_in"
    },
    {
      "id": "e8",
      "source_node_id": "reader",
      "source_port_id": "text",
      "target_node_id": "page",
      "target_port_id": "content_in"
    }
  ]
}
