{
  "metadata": {
    "name": "Chat",
    "version": "1.0.0",
    "description": "A chatbot is two nodes: a page with a chat block, and a model. Sending a message starts the graph at the AI node; the answer comes back into the conversation, and the conversation goes out again as history with the next message.",
    "author": "",
    "tags": [
      "example",
      "ai",
      "chat",
      "gui"
    ],
    "ai_defaults": {
      "provider": "default",
      "model": ""
    },
    "gui_scheme": "night"
  },
  "nodes": [
    {
      "id": "page",
      "node_type": "gui",
      "label": "Chat",
      "description": "The page this tool shows",
      "inputs": [
        {
          "id": "chat_in",
          "name": "chat: reply",
          "kind": "input",
          "data_type": "any",
          "multi": false,
          "required": false,
          "description": "The answer to the message just sent. It is added to the conversation."
        }
      ],
      "outputs": [
        {
          "id": "chat_out",
          "name": "chat: message",
          "kind": "output",
          "data_type": "text",
          "multi": false,
          "required": false,
          "description": "What the person just sent. Sending it starts the graph from whatever this is wired to."
        },
        {
          "id": "chat_history",
          "name": "chat: history",
          "kind": "output",
          "data_type": "text",
          "multi": false,
          "required": false,
          "description": "Everything said before this message, one turn per paragraph."
        }
      ],
      "config": {
        "gui_widgets": [
          {
            "h": 1,
            "id": "title",
            "kind": "text",
            "label": "",
            "mode": "heading",
            "tone": "plain",
            "value": "Chat",
            "w": 16
          },
          {
            "h": 10,
            "id": "chat",
            "kind": "chat",
            "tone": "plain",
            "value": {
              "messages": [],
              "pending": ""
            },
            "w": 16
          }
        ]
      }
    },
    {
      "id": "assistant",
      "node_type": "ai",
      "label": "Assistant",
      "description": "Answers the last message, knowing the conversation so far",
      "inputs": [
        {
          "id": "history",
          "name": "History",
          "kind": "input",
          "data_type": "text",
          "multi": false,
          "required": false,
          "description": ""
        },
        {
          "id": "message",
          "name": "Message",
          "kind": "input",
          "data_type": "text",
          "multi": false,
          "required": true,
          "description": ""
        }
      ],
      "outputs": [
        {
          "id": "output",
          "name": "Reply",
          "kind": "output",
          "data_type": "text",
          "multi": false,
          "required": false,
          "description": ""
        }
      ],
      "config": {
        "ai_model": "gemini-flash-lite-latest",
        "ai_provider": "google",
        "batch_mode": "whole_list",
        "output_format": "text",
        "temperature": 0.7
      }
    }
  ],
  "edges": [
    {
      "id": "message-to-assistant",
      "source_node_id": "page",
      "source_port_id": "chat_out",
      "target_node_id": "assistant",
      "target_port_id": "message"
    },
    {
      "id": "history-to-assistant",
      "source_node_id": "page",
      "source_port_id": "chat_history",
      "target_node_id": "assistant",
      "target_port_id": "history"
    },
    {
      "id": "reply-to-chat",
      "source_node_id": "assistant",
      "source_port_id": "output",
      "target_node_id": "page",
      "target_port_id": "chat_in"
    }
  ]
}
