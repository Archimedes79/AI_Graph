{
  "metadata": {
    "name": "Summarize a folder",
    "version": "1.0.0",
    "description": "Choose a folder and read a summary of every text file in it. One page, one model: the AI node runs once per file, and the page shows the summaries one under the other. Choosing a folder starts it. Paths are relative to the working directory, so run this from the repository root.",
    "author": "",
    "tags": [
      "example",
      "ai",
      "files",
      "gui"
    ],
    "ai_defaults": {
      "provider": "default",
      "model": ""
    },
    "gui_scheme": "night"
  },
  "nodes": [
    {
      "id": "page",
      "node_type": "gui",
      "label": "Folder summaries",
      "description": "The page this tool shows",
      "inputs": [
        {
          "id": "summaries_in",
          "name": "Summaries",
          "kind": "input",
          "data_type": "any",
          "multi": false,
          "required": false,
          "description": ""
        }
      ],
      "outputs": [
        {
          "id": "folder_out",
          "name": "Folder",
          "kind": "output",
          "data_type": "file_path",
          "multi": true,
          "required": false,
          "description": ""
        }
      ],
      "config": {
        "gui_widgets": [
          {
            "h": 1,
            "id": "title",
            "kind": "text",
            "label": "",
            "mode": "heading",
            "tone": "plain",
            "value": "Summarize a folder",
            "w": 16
          },
          {
            "extensions": ".txt",
            "h": 2,
            "id": "folder",
            "kind": "input_picker",
            "label": "Folder",
            "mode": "directory",
            "run_on_change": true,
            "select_all_files": true,
            "tone": "sunken",
            "value": "examples/data/stories",
            "w": 16
          },
          {
            "h": 10,
            "id": "summaries",
            "kind": "text_io",
            "label": "Summaries",
            "mode": "output",
            "tone": "raised",
            "w": 16
          }
        ]
      }
    },
    {
      "id": "summarize",
      "node_type": "ai",
      "label": "Each file",
      "description": "Summarizes one file; runs once per file in the folder",
      "inputs": [
        {
          "id": "story",
          "name": "Story",
          "kind": "input",
          "data_type": "file_path",
          "multi": true,
          "required": false,
          "description": ""
        }
      ],
      "outputs": [
        {
          "id": "output",
          "name": "Summary",
          "kind": "output",
          "data_type": "text",
          "multi": true,
          "required": false,
          "description": ""
        }
      ],
      "config": {
        "ai_model": "gemini-flash-lite-latest",
        "ai_provider": "google",
        "batch_concurrency": 3,
        "batch_mode": "per_item",
        "output_format": "text",
        "read_file_inputs": true,
        "temperature": 0.3
      }
    }
  ],
  "edges": [
    {
      "id": "folder-to-summarize",
      "source_node_id": "page",
      "source_port_id": "folder_out",
      "target_node_id": "summarize",
      "target_port_id": "story"
    },
    {
      "id": "summaries-to-page",
      "source_node_id": "summarize",
      "source_port_id": "output",
      "target_node_id": "page",
      "target_port_id": "summaries_in"
    }
  ]
}
