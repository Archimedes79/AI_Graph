{
  "metadata": {
    "name": "GUI: File Open -> AI -> Text Window",
    "version": "1.0.0",
    "description": "A single GUI node holds a File Open widget and a Text Window widget. The chosen file is summarized by the AI node, whose answer is fed back into the Text Window. Because that closing edge points back at the same GUI node it would form a cycle, so it is automatically excluded from cycle detection (a gui/widget node is a 'memory' element) and its value is written into the Text Window's own stored value once the round finishes -- so it shows the fresh answer immediately, and the NEXT run's output reflects it too.",
    "author": "AI-Graph",
    "tags": [
      "example",
      "gui",
      "memory-feedback"
    ],
    "gui_scheme": "night"
  },
