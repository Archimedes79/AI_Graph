        },
        {
          "id": "length_out",
          "name": "Length",
          "kind": "output",
          "data_type": "text",
          "multi": false,
          "required": false,
          "description": ""
        },
        {
          "id": "go_out",
          "name": "Summarize",
          "kind": "output",
          "data_type": "number",
          "multi": false,
          "required": false,
          "description": ""
        }
      ],
      "config": {
        "gui_widgets": [
          {
            "id": "title",
            "kind": "text",
            "label": "",
            "tone": "plain",
            "w": 16,
            "h": 1,
            "mode": "heading",
            "value": "File reader & summarizer"
          },
          {
            "id": "intro",
            "kind": "text",
            "label": "",
            "tone": "plain",
            "w": 16,
            "h": 1,
            "mode": "caption",
            "value": "Choose a text file — it is read and summarized straight away. Change the length and it is summarized again."
          },
          {
            "id": "file",
            "kind": "input_picker",
            "label": "File",
            "tone": "sunken",
            "w": 9,
            "h": 2,
            "mode": "file",
            "value": "examples/data/stories/01_the_lighthouse_keeper.txt",
            "extensions": ".txt,.md",
            "run_on_change": true
          },
          {
            "id": "length",
            "kind": "select",
            "label": "Length",
            "tone": "sunken",
            "w": 4,
            "h": 2,
            "options": "One sentence\nThree sentences\nFive bullet points",
            "value": "Three sentences",
            "run_on_change": true
          },
          {
            "id": "go",
            "kind": "button",
            "label": "Summarize",
            "tone": "plain",
            "w": 3,
            "h": 2
          },
          {
            "id": "rule",
            "kind": "divider",
            "label": "",
            "tone": "plain",
            "w": 16,
            "h": 1,
            "mode": "horizontal"
          },
          {
            "id": "summary",
            "kind": "text_io",
            "label": "Summary",
            "tone": "raised",
            "w": 10,
            "h": 5,
            "mode": "output"
          },
          {
            "id": "about",
            "kind": "text_io",
            "label": "About the file",
            "tone": "raised",
            "w": 6,
            "h": 5,
            "mode": "output"
          },
          {
            "id": "content",
            "kind": "text_io",
            "label": "What was read",
            "tone": "raised",
            "w": 16,
            "h": 6,
            "mode": "output"
          }
        ]
      }
    },
    {
      "id": "reader",
      "node_type": "code",
      "label": "Read file",
      "description": "Reads the chosen file and says what it is",
      "position": {
        "x": 560,
        "y": 60
      },
      "inputs": [
        {
          "id": "file",
          "name": "File",
          "kind": "input",
          "data_type": "file_path",
          "multi": false,
          "required": false,
          "description": "The chosen file; arrives as its content"
        },
        {
          "id": "path",
          "name": "Path",
          "kind": "input",
          "data_type": "text",
          "multi": false,
          "required": false,
          "description": "The same file's path, for its name"
        }
      ],
      "outputs": [
        {
          "id": "text",
          "name": "Text",
          "kind": "output",
          "data_type": "text",
          "multi": false,
          "required": false,
          "description": "The file's content"
        },
        {
          "id": "info",
          "name": "Info",
          "kind": "output",
          "data_type": "text",
          "multi": false,
          "required": false,
          "description": "One line about the file"
        }
      ],
      "config": {
        "code": "/**\n * The chosen file, as text -- and one line saying what it is.\n *\n * @typedef {Object} Inputs\n * @property {string} file  the file's content (read for us: the port is a file path)\n * @property {string} path  the same file's path, for its name\n */\n\n/** @param {Inputs} inputs */\nfunction run(inputs) {\n  const text = String(inputs.file ?? '');\n  const name = String(inputs.path ?? '').split(/[\\\\/]/).pop() || 'no file chosen';\n  const words = text.split(/\\s+/).filter(Boolean).length;\n  const minutes = Math.max(1, Math.round(words / 200));\n  return {\n    text,\n    info: name + '\\n' + words.toLocaleString('en') + ' words · ' + text.length.toLocaleString('en')\n      + ' characters · about ' + minutes + ' min to read',\n  };\n}\n",
        "code_prompt": "Pass the file's text on, and describe the file in one line: its name, word count, character count and reading time.",
        "batch_mode": "whole_list",
        "read_file_inputs": true
      }
    },
    {
      "id": "summarizer",
      "node_type": "ai",
      "label": "Summarize",
      "description": "Summarize the text faithfully, at the length asked for.",
      "position": {
        "x": 860,
        "y": 200
      },
      "inputs": [
        {
          "id": "text",
          "name": "Text",
          "kind": "input",
          "data_type": "text",
          "multi": false,
          "required": false,
          "description": "What to summarize"
        },
        {
          "id": "length",
          "name": "Length",
          "kind": "input",
          "data_type": "text",
          "multi": false,
          "required": false,
          "description": "How long the summary should be"
        }
      ],
      "outputs": [
        {
          "id": "output",
          "name": "Output",
          "kind": "output",
          "data_type": "text",
          "multi": false,
          "required": false,
          "description": "What the model answered"
        }
      ],
      "config": {
        "ai_provider": "google",
        "ai_model": "gemini-flash-lite-latest",
        "temperature": 0.3,
        "system_prompt": "You summarize texts faithfully. Say what the text is about and what it comes to; add nothing that is not in it and do not judge it. Answer in the language of the text. Output the summary only — no preamble, no title.",
        "prompt_template": "Length of the summary: {{length}}\n\nThe text:\n{{text}}",
        "output_format": "text",
        "batch_mode": "whole_list",
        "read_file_inputs": false
      }
    }
  ],
