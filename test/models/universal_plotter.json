          "description": ""
        }
      ],
      "config": {
        "language": "python",
        "read_file_inputs": true,
        "code": "def run(inputs):\n    import csv\n    import io\n\n    raw = inputs.get('input') or ''\n    rows = list(csv.DictReader(io.StringIO(raw)))\n    points = []\n    for i, row in enumerate(rows):\n        try:\n            y = float(row.get('y', row.get('value', 0)))\n        except Exception:\n            y = 0.0\n        x_raw = row.get('x')\n        try:\n            x = float(x_raw) if x_raw is not None and x_raw != '' else i\n        except Exception:\n            x = i\n        points.append({'x': x, 'y': y})\n    return {'output': points}\n"
      }
    },
