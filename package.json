{
  "name": "ai-graph",
  "private": true,
  "description": "One workspace: the engine, and the editor that is built on it.",
  "workspaces": [
    "engine",
    "frontend"
  ],
  "scripts": {
    "start": "node engine/src/main.ts --editor frontend/dist",
    "dev": "node scripts/dev.mjs",
