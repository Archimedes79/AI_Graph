{
  "name": "ai-graph",
  "private": true,
  "description": "One workspace: the engine, and the editor that is built on it.",
  "workspaces": [
    "engine",
    "editor"
  ],
  "scripts": {
    "start": "node engine/src/main.ts --editor editor/dist",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace editor",
    "package": "npm run build && node scripts/package.mjs",
    "test": "npm test --workspaces",
    "typecheck": "npm run typecheck --workspaces"
  }
}
