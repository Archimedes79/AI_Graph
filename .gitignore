# Local environment, and what older local builds left in the working copy.
.env
.venv/
/backend/
/build/
/dist/

# Node
node_modules/
editor/dist/
editor/.vite/
*.tsbuildinfo

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/*
# ...but keep the shared workspace config (test discovery, run tasks)
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo

# Data
# Attachments and other things a running editor keeps beside the project.
/data/
*.log

# AI credentials written by ⚙ Settings → Keys and addresses. Its default location
# is the working directory, which for a dev run is this repo -- never commit it.
ai-settings.json

# Local editor/agent scratch, not part of the project.
.claude/

# The engine's installed packages.
engine/node_modules/

# The last scheduled run a served tool keeps beside its graph.
*.last-run.json

# The downloadable package, built by scripts/package.mjs.
ai-graph*.zip
